#!/bin/sh

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

echo "Running staged-file quality checks before commit..."

ESLINT_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|mts|tsx|js|mjs|cjs|vue)$')
PRETTIER_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|mts|tsx|js|mjs|cjs|vue|json|md|css|scss|html|yml|yaml)$')

if [ -n "$ESLINT_FILES" ]; then
  echo "$ESLINT_FILES" | xargs pnpm exec eslint --max-warnings=0
fi

if [ -n "$PRETTIER_FILES" ]; then
  echo "$PRETTIER_FILES" | xargs pnpm exec prettier --check
fi
